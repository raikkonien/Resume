# 全新安装无需 .env、任何密码或 Token；下面均为可选设置。
# Compose 可复制本文件为 .env；docker run 需显式使用 -e 或 --env-file。
#
# 仅首次迁移旧版数据：为原个人账号 zhangrui 指定原密码。
# 空目录默认只创建 admin；不要为全新安装设置此变量。
# 变更此变量不会重置已存在账号密码。
ADMIN_PASSWORD=
# 可选：指定 admin 的首次密码（8–256 位，建议 20 位以上随机密码）。
# 留空时生成随机密码，仅在首次初始化日志显示一次；之后在管理页改密码。
INITIAL_ADMIN_PASSWORD=
# 仅随旧版首次迁移，将只读 MCP Token 绑定至 zhangrui；全新安装无需设置。
# 已初始化后改此变量不会新增或轮换 Token；目前管理 UI 不提供 Token 管理。
MCP_TOKEN=
# 留空时自动生成并持久化为 /data/.session-key，重启保留会话。
# 可选显式密钥覆盖；请长期保留，变更会使已有会话失效。
SECRET_KEY=
# 镜像与 Compose 固定使用 /data；无需修改容器内路径。
DATA_DIR=/data
# MCP 附件下载链接的外部地址；变更映射端口/域名时同步修改。
PUBLIC_BASE_URL=http://localhost:18081
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*
MAX_UPLOAD_MB=20
# 以下仅用于 Compose；首次发布需确认 GHCR Package 已设为 Public。
IMAGE=ghcr.io/raikkonien/resume:latest
DATA_PATH=./data
BIND_ADDR=127.0.0.1
PORT=18081
